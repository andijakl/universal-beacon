<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.0: platform-independent beacon parsing and BeaconManager.
      Platform targets additionally include a ready-to-use IBluetoothPacketProvider.
    -->
    <TargetFrameworks>netstandard2.0;net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0-windows10.0.19041.0</TargetFrameworks>
    <RootNamespace>UniversalBeacon.Library</RootNamespace>
    <AssemblyName>UniversalBeacon.Library</AssemblyName>
    <NeutralLanguage>en</NeutralLanguage>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Not every public member is documented yet. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <TargetPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</TargetPlatform>
    <SupportedOSPlatformVersion Condition="'$(TargetPlatform)' == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetPlatform)' == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetPlatform)' == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetPlatform)' == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="'$(TargetPlatform)' == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
  </PropertyGroup>

  <!-- Platform-specific Bluetooth providers -->
  <ItemGroup Condition="'$(TargetPlatform)' != 'android'">
    <Compile Remove="Platforms\Android\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetPlatform)' != 'ios' AND '$(TargetPlatform)' != 'maccatalyst'">
    <Compile Remove="Platforms\Apple\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetPlatform)' != 'windows'">
    <Compile Remove="Platforms\Windows\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Platforms\**\*.cs" Exclude="@(Compile)" />
  </ItemGroup>

  <!-- NuGet package -->
  <PropertyGroup>
    <PackageId>UniversalBeaconLibrary</PackageId>
    <Version>4.1.0</Version>
    <Title>Universal Bluetooth Beacon Library</Title>
    <Product>Universal Beacon Library</Product>
    <Description>Manage Bluetooth Beacons on Android, iOS, macOS and Windows. Manages received Bluetooth LE advertisements, clusters them into individual beacons and parses the payloads according to the Eddystone specification (UID, URL, TLM, encrypted TLM, EID), the Find Hub Network accessory frames, as well as beacons comparable to the iBeacon / Proximity Beacon format by Apple.</Description>
    <PackageTags>bluetooth beacon beacons ibeacon eddystone bluetoothle ble proximity maui android ios windows</PackageTags>
    <PackageProjectUrl>https://github.com/andijakl/universal-beacon</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageIcon>UniversalBeaconLibraryLogo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/andijakl/universal-beacon#version-history</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\UniversalBeaconLibraryLogo.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UniversalBeacon.Library.Tests" />
  </ItemGroup>

</Project>
